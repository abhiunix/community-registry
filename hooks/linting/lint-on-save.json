{
  "name": "lint-on-save",
  "display_name": "Lint on Save",
  "description": "Automatically runs ESLint on saved files to catch issues immediately",
  "category": "linting",
  "author": "community",
  "author_github": "",
  "version": "1.0.0",
  "tags": [
    "linting",
    "eslint",
    "automation",
    "code-quality"
  ],
  "compatible_adapters": [
    "claude-code",
    "cursor",
    "windsurf"
  ],
  "trigger": "file_save",
  "command": "npx eslint --fix $FILE_PATH",
  "source": {
    "repo": "abhiunix/community-registry",
