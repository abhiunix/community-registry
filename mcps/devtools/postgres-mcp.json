{
  "name": "postgres-mcp",
  "display_name": "PostgreSQL MCP Server",
  "description": "Provides PostgreSQL database access for queries, schema inspection, and data operations",
  "category": "devtools",
  "author": "dbtools-org",
  "author_github": "modelcontextprotocol",
  "version": "1.0.0",
  "tags": [
    "database",
    "postgres",
    "sql",
    "data"
  ],
  "compatible_adapters": [
    "claude-code",
    "cursor",
    "windsurf"
  ],
  "transport": "stdio",
  "command": "npx",
  "args": [
    "-y",
    "@modelcontextprotocol/server-postgres"
  ],
  "env": {
    "POSTGRES_CONNECTION_STRING": {
      "type": "secret",
      "label": "${POSTGRES_CONNECTION_STRING}",
      "required": true
    }
  },
  "source": {
    "repo": "abhiunix/community-registry",
    "url": "https://github.com/abhiunix/community-registry/blob/main/mcps/devtools/postgres-mcp.json"
  },
  "stats": {
    "github_stars": 1,
    "updated_at": "2026-07-27"
  },
  "license": "MIT"
}
